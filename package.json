{
  "name": "raft-agent-control-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local MCP adapter for Raft human-session agent configuration and lifecycle APIs",
  "bin": {
    "raft-agent-mcp": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test",
    "check": "node --check src/client.mjs && node --check src/controller.mjs && node --check src/server.mjs && node --check src/cli.mjs",
    "format": "prettier --write \"src/**/*.mjs\" \"test/**/*.mjs\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.mjs\" \"test/**/*.mjs\" eslint.config.mjs",
    "lint": "eslint \"src/**/*.mjs\" \"test/**/*.mjs\" eslint.config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyzh/raft-mcp.git"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  }
}
